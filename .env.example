# Copy to .env.local (ignored by git) and fill in to send real sign-ups.
#
# Mailing-list endpoint for the Vines & Vinyl landing page's sign-up form
# (src/examples/submitSignup.ts). Receives a JSON POST of { "email": "…" };
# any 2xx response counts as success. Leave unset to use the built-in mock,
# which resolves after 800ms and stores nothing.
VITE_SIGNUP_ENDPOINT=
